@page "/registration"

@using BwMelder.Shared.Clubs
@using BwMelder.Shared.Crews
@using BwMelder.Shared.TeamCoaches
@using BwMelder.Web.Authentication

@inject IClubService ClubService

<PageTitle>Registrierung</PageTitle>

<h1>Übersicht</h1>
<p class="lead">
    für @userInfo?.ClubName
</p>

<ClubEntriesOverview Crews="entries.Crews" />

@code {

    private ClubEntriesResponse? entries;
    
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private UserInfo? userInfo;

    protected override async Task OnInitializedAsync()
    {
        userInfo = await AuthenticationState.GetUserInfoAsync();
        var clubId = userInfo?.ClubId ?? throw new ApplicationException("Cannot access Club ID to process request.");
        
        entries = await ClubService.GetClubEntriesAsync(clubId);
    }
}