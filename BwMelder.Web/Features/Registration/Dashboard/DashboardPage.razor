@page "/registration"

@using BwMelder.Shared.ClubCoaches
@using BwMelder.Shared.Clubs
@using BwMelder.Shared.Crews
@using BwMelder.Shared.TeamCoaches
@using BwMelder.Web.Authentication

@inject IClubCoachService ClubCoachService
@inject IClubService ClubService

<PageTitle>Registrierung</PageTitle>

<h1>Anmeldung zum BW</h1>
<p class="lead">
    für @userInfo?.ClubName
</p>

@if (incompleteCrews.Count > 0)
{
    <h2>Offen</h2>
    <ClubCrewList Crews="incompleteCrews"/>
}
else
{
    <div class="alert alert-primary">
        <strong>Momentan alles erledigt!</strong>
        Wir benachrichtigen dich, falls es etwas Neues gibt. 
    </div>
}

@if (completedCrews.Count > 0 || true)
{
    <h2>Erledigt</h2>
    <ClubCrewList Crews="completedCrews" />
}

<h2>Ansprechpartner</h2>
<ClubCoachDisplay ClubCoach="clubCoach" />

@code {

    private IReadOnlyList<ClubCrewResponse> incompleteCrews = [];
    private IReadOnlyList<ClubCrewResponse> completedCrews = [];

    private ClubCoachResponse? clubCoach;
    
    private UserInfo? userInfo;
    
    [CascadingParameter]
    public Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Retrieve the club ID from the logged-in user's data.
        userInfo = await AuthenticationState.GetUserInfoAsync();
        var clubId = userInfo?.ClubId ?? throw new ApplicationException("Cannot access Club ID to process request.");
        
        // Load entries associated with the club.
        var entries = await ClubService.GetClubEntriesAsync(clubId);
        completedCrews = entries.Crews.Where(c => c.RegistrationProgress.IsComplete()).ToList();
        incompleteCrews = entries.Crews.Where(c => !c.RegistrationProgress.IsComplete()).ToList();
        
        // Load club coach.
        // This should always return a non-null response, otherwise the user should have been directed to onboarding.
        clubCoach = await ClubCoachService.GetClubCoachAsync(clubId);
    }
}