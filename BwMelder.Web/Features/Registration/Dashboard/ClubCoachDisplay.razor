@using BwMelder.Shared.ClubCoaches

@* Wrap single item into a list so the ListGroup component can consume it. *@
<ListGroup Items="[ClubCoach]">
    <ItemTemplate>
        <ListGroupItem>
            <div class="d-flex align-items-center">
                <div>
                    @context.Name<br/>
                    <small class="text-secondary">
                        @context.Contact.EmailAddress, @context.Contact.Phone
                    </small>
                </div>
                <div class="ms-auto ps-3">
                    <i class="bi bi-chevron-right"></i>
                </div>
            </div>
        </ListGroupItem>
    </ItemTemplate>
</ListGroup>

@code {
    
    [Parameter, EditorRequired]
    public ClubCoachResponse ClubCoach { get; set; } = null!;
    
}