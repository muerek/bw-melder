@using BwMelder.Shared.Races

<option value=""></option>
@foreach (var race in GetOrderedRaces())
{
    <option value="@race.Id">
        @race.Number - @race.Name
    </option>
}

@code {

    [Parameter, EditorRequired]
    public IEnumerable<RaceSummaryResponse> Races { get; set; } = [];
    
    private IOrderedEnumerable<RaceSummaryResponse> GetOrderedRaces()=>
        Races.OrderBy(r => r.Number.Length).ThenBy(r => r.Number);
    
}