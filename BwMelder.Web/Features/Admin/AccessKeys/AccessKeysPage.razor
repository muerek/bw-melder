@page "/admin/access-keys"
@using BwMelder.Shared.Authentication
@rendermode InteractiveServer

@using BwMelder.Shared.Clubs

@inject IAccessKeyService AccessKeyService
@inject IClubService ClubService

<PageTitle>Zugänge</PageTitle>

<h1>Zugänge</h1>

<p>
    Jeder Verein erhält einen Zugang zur Anmeldung seiner Sportler und Betreuer.
    Der Zugang wird bei der ersten Nominierung automatisch angelegt.
    Bei Bedarf können die Zugänge erneuert oder gesperrt werden.
</p>

<Accordion>
    @foreach (var clubKey in clubKeys!)
    {
        <ClubKeyAccordionItem ClubKey="clubKey"
                     OnRenew="() => RenewAccess(clubKey.ClubId)"
                     OnLock="() => LockAccess(clubKey.ClubId)" />
    }    
</Accordion>


@code {
    private IReadOnlyList<ClubKeyResponse>? clubKeys;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task RenewAccess(Guid clubId)
    {
        await AccessKeyService.RenewAccessAsync(clubId);
        // Load updated data.
        await LoadDataAsync();
        StateHasChanged();
    }

    private async Task LockAccess(Guid clubId)
    {
        await AccessKeyService.LockAccessAsync(clubId);
        await LoadDataAsync();
        StateHasChanged();
    }

    private async Task LoadDataAsync() => clubKeys = await ClubService.GetClubKeysAsync();
}
