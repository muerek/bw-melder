@page "/admin/crews"

@using BwMelder.Shared.Crews

@inject ICrewService CrewService

<PageTitle>Mannschaften</PageTitle>

<h1>Mannschaften</h1>

<a href="/admin/crews/nominate" class="btn btn-primary">Nominieren</a>

<table class="table">
    <thead>
        <tr>
            <th>Rennen</th>
            <th>Verein</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var crew in Crews)
        {
            <tr>
                <td>@crew.Race.DisplayName</td>
                <td>@crew.Club.Name</td>
                <td class="@GetStatusClass(crew)">
                    @crew.Status.CurrentAthleteCount von @crew.Status.TargetAthleteCount
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private IList<CrewSummaryResponse> Crews { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        Crews = await CrewService.GetAllCrewsAsync();
    }

    private static string GetStatusClass(CrewSummaryResponse crew)
    {
        return (crew.Status.CurrentAthleteCount, crew.Status.TargetAthleteCount) switch
        {
            // No athletes were added yet, red highlight.
            (0, _) => "table-danger",
            // Some were added, but not all of them, yellow highlight.
            var (x, y) when x < y => "table-warning",
            // All were added, green highlight.
            var (x, y) when x == y => "table-success",
            _ => ""
        };
    }
}
