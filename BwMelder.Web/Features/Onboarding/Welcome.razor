@page "/onboarding/welcome"

@using BwMelder.Web.Authentication

<PageTitle>Willkommen</PageTitle>

<div class="text-center">
    <p class="display-1">
        <i class="bi bi-trophy"></i>
    </p>
    <p class="display-4 mb-1">
        @(userContext?.ClubName ?? "Dein Verein")
    </p>
    <p class="lead">
        fährt mit zum Bundeswettbewerb!
    </p>
</div>
<p>
    Hier kannst du Sportler und Betreuer anmelden.
    Zuerst müssen wir aber wissen, an wen wir uns für die Organisation wenden können.
    Bitte gib auf der nächsten Seite deine Kontaktdaten an.
</p>
<a class="btn btn-primary" href="/onboarding/club-coach">Weiter</a>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    private UserInfo? userContext;

    protected override async Task OnInitializedAsync()
    {
        userContext = await authenticationState.GetUserInfoAsync();
    }
}
