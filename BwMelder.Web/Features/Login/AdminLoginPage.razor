@page "/admin/login"

@* Make sure anyone can access this page. *@
@attribute [AllowAnonymous]

@using BwMelder.Shared.Authentication
@using BwMelder.Web.Authentication

@inject AuthenticationHandler AuthHandler
@inject NavigationManager Navigation

<PageTitle>Anmelden</PageTitle>

<h1>Anmelden</h1>

<div class="row">
    <div class="col-md-3">
        <EditForm Model="Credentials" OnValidSubmit="AuthenticateAsync" FormName="LoginForm">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="mb-3">
                <label for="username" class="form-label">Benutzername</label>
                <InputText id="username" class="form-control" @bind-Value="Credentials!.Username" />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Passwort</label>
                <InputText id="password" class="form-control" type="password" @bind-Value="Credentials!.Password" />
            </div>
            <button type="submit" class="btn btn-primary">Anmelden</button>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private UserLoginRequest? Credentials { get; set; }

    // Initialize empty credentials if not set from form.
    protected override void OnInitialized() =>
        Credentials ??= new() { Username = string.Empty, Password = string.Empty };

    private async Task AuthenticateAsync()
    {
        if (await AuthHandler.LoginAsync(Credentials!))
        {
            Navigation.NavigateTo("/");
        }
    }

}
