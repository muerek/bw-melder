@typeparam TItem

<div class="accordion" id="@HtmlId">
    <CascadingValue Value="this">
        @foreach (var item in Items)
        {
            @ItemTemplate(item)
        }
    </CascadingValue>
</div>

@code {

    [Parameter, EditorRequired]
    public IEnumerable<TItem> Items { get; set; } = null!;

    [Parameter, EditorRequired]
    public RenderFragment<TItem> ItemTemplate { get; set; } = null!;

    /// <summary>
    /// HTML ID of this accordion.
    /// Child elements can access this through the cascading parameter.
    /// They need access to it so all but one panel stay collapsed. 
    /// </summary>
    public string HtmlId { get; private set; } = string.Empty;

    protected override void OnInitialized()
    {
        HtmlId = HtmlIdGenerator.GetId();
    }

}
