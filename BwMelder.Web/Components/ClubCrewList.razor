@using BwMelder.Shared.Crews

<ListGroup Items="Crews" @Context="crew">
    <ItemTemplate>
        <ListGroupItem Href="/registration/crew/@crew.CrewId">
            <div class="d-flex align-items-center">
                <div class="pe-3">
                    <RegistrationStatusIcon Status="crew.RegistrationProgress.GetStatus()"/>
                </div>
                <div>
                    @crew.Race.Number @crew.Race.Name<br/>
                    <small class="text-secondary">
                        Max Mustermann, Golo Wombat
                    </small>
                </div>
                <div class="ms-auto ps-3">
                    <i class="bi bi-chevron-right"></i>
                </div>
            </div>
        </ListGroupItem>
    </ItemTemplate>
</ListGroup>

@code {

    [Parameter, EditorRequired]
    public IReadOnlyList<ClubCrewResponse> Crews { get; set; } = null!;

}