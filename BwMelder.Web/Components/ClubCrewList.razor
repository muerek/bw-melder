@using BwMelder.Shared.Crews

<div class="list-group mb-3">
    @foreach (var crew in Crews)
    {
        <a href="/registration/crew/@crew.CrewId" class="list-group-item list-group-item-action">
            <div class="d-flex align-items-center">
                <div class="pe-3">
                    <RegistrationStatusIcon Status="crew.RegistrationProgress.GetStatus()"/>
                </div>
                <div>
                    @crew.Race.Number @crew.Race.Name<br/>
                    <small class="text-secondary">
                        Max Mustermann, Golo Wombat
                    </small>
                </div>
                <div class="ms-auto ps-3">
                    <i class="bi bi-chevron-right"></i>
                </div>
            </div>
        </a>
    }
</div>

@code {

    [Parameter, EditorRequired]
    public IReadOnlyList<ClubCrewResponse> Crews { get; set; } = null!;

}