@using BwMelder.Shared.Clubs
@using BwMelder.Shared.Crews


<h2>Mannschaften</h2>

<h3>Offen</h3>
<ClubCrewList Crews="incompleteCrews" />

<h3>Erledigt</h3>
<ClubCrewList Crews="completedCrews" />


@code {
    
    private IReadOnlyList<ClubCrewResponse> incompleteCrews = [];
    private IReadOnlyList<ClubCrewResponse> completedCrews = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<ClubCrewResponse> Crews { get; set; } = null!;

    protected override void OnInitialized()
    {
        completedCrews = Crews.Where(c => c.RegistrationProgress.IsComplete()).ToList();
        incompleteCrews = Crews.Where(c => !c.RegistrationProgress.IsComplete()).ToList();
    }

}