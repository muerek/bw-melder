@attribute [CascadingTypeParameter(nameof(TItem))]
@typeparam TItem

<div class="accordion-item">
    <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@htmlId">
            @HeaderContent
        </button>
    </h2>
    <div id="@htmlId" class="accordion-collapse collapse" data-bs-parent="#@AncestorAccordion?.HtmlId">
        <div class="accordion-body">
            @BodyContent
        </div>
    </div>
</div>

@code {
    private string htmlId = string.Empty;

    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    [Parameter]
    public RenderFragment? BodyContent { get; set; }

    // Ancestor accordion must be set as parent so panels will auto-collapse when another one is opened.
    [CascadingParameter]
    public Accordion<TItem>? AncestorAccordion { get; set; }

    protected override void OnInitialized()
    {
        htmlId = HtmlIdGenerator.GetId();
    }

}