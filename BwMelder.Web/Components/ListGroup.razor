@typeparam TItem

<div class="list-group mb-3">
    @foreach (var item in Items)
    {
        @ItemTemplate(item)
    }
</div>

@code {

    [Parameter, EditorRequired]
    public IEnumerable<TItem> Items { get; set; } = null!;

    [Parameter, EditorRequired]
    public RenderFragment<TItem> ItemTemplate { get; set; } = null!;

}