@page "/admin/crews/add"

@inject IClubService ClubService
@inject ICrewService CrewService
@inject IRaceService RaceService
@inject NavigationManager Navigation

<h1>Mannschaft nominieren</h1>

<EditForm Model="Nomination" OnValidSubmit="NominateAsync" FormName="NominationForm">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="row row-cols-md-2">
        <div class="mb-3">
            <label for="raceid" class="form-label">Rennen</label>
            <InputSelect class="form-select" id="raceid" required @bind-Value=Nomination!.RaceId>
                <option value=""></option>
                @foreach (var race in Races)
                {
                    <option value="@race.Id">@race.FullName()</option>
                }
            </InputSelect>
        </div>
        <div class="mb-3">
            <label for="clubid" class="form-label">Verein</label>
            <InputSelect class="form-select" id="clubid" required @bind-Value=Nomination!.ClubId>
                <option value=""></option>
                @foreach (var club in Clubs)
                {
                    <option value="@club.Id">@club.Name</option>
                }
            </InputSelect>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Speichern</button>
</EditForm>

<h3>Verein neu anlegen</h3>

<EditForm Model="NewClub" OnValidSubmit="CreateClubAsync" FormName="NewClubForm">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label for="clubname" class="form-label">Vereinsname</label>
        <InputText id="clubname" class="form-control" @bind-Value="NewClub!.Name" />
    </div>
    <button type="submit" class="btn btn-primary">Speichern</button>
</EditForm>

@code {
    private IList<ClubResponse> Clubs { get; set; } = [];
    private IList<RaceResponse> Races { get; set; } = [];

    [SupplyParameterFromForm(FormName = "NominationForm")]
    private CreateCrewRequest? Nomination { get; set; }

    [SupplyParameterFromForm(FormName = "NewClubForm")]
    private CreateClubRequest? NewClub { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Races = await RaceService.GetRacesAsync();
        Nomination ??= new();

        // Only load club list if we are not about to add a new one.
        if (NewClub is null)
        {
            Clubs = await ClubService.GetClubsAsync();
            NewClub ??= new();
        }
    }

    private async Task CreateClubAsync()
    {
        if (NewClub is null) { return; }

        var clubId = await ClubService.CreateClubAsync(NewClub);

        // Load updated club list.
        Clubs = await ClubService.GetClubsAsync();
        // Reset the NewClubForm.
        NewClub = new();
        // Pre-select the newly created club in the NominationForm.
        Nomination!.ClubId = clubId;
    }

    private async Task NominateAsync()
    {
        if (Nomination is null) { return; }

        await CrewService.CreateCrewAsync(Nomination);
        Navigation.NavigateTo("/admin/crews");
    }
}
