@page "/admin/crews/nominate"

@inject IClubService ClubService
@inject INominationService NominationService
@inject IRaceService RaceService
@inject NavigationManager Navigation

<h1>Mannschaft nominieren</h1>

<h3>Für bestehenden Verein</h3>
<EditForm Model="Nomination" OnValidSubmit="NominateExistingClubAsync" FormName="NominateExistingClubForm">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="row row-cols-md-2">

        <div class="mb-3">
            <label for="raceid" class="form-label">Rennen</label>
            <InputSelect class="form-select" id="raceid" required @bind-Value=Nomination!.RaceId>
                <option value=""></option>
                @foreach (var race in Races)
                {
                    <option value="@race.Id">@race.FullName()</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label for="clubid" class="form-label">Verein</label>
            <InputSelect class="form-select" id="clubid" required @bind-Value=Nomination!.ClubId>
                <option value=""></option>
                @foreach (var club in Clubs)
                {
                    <option value="@club.Id">@club.Name</option>
                }
            </InputSelect>
        </div>

    </div>
    <button type="submit" class="btn btn-primary">Speichern</button>
</EditForm>

<h3>Für neuen Verein</h3>
<EditForm Model="NewClubNomination" OnValidSubmit="NominateNewClubAsync" FormName="NominateNewClubForm">
    <ObjectGraphDataAnnotationsValidator />
    <ValidationSummary />
    <div class="row row-cols-md-2">

        <div class="mb-3">
            <label for="raceid" class="form-label">Rennen</label>
            <InputSelect class="form-select" id="raceid" required @bind-Value=NewClubNomination!.RaceId>
                <option value=""></option>
                @foreach (var race in Races)
                {
                    <option value="@race.Id">@race.FullName()</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label for="clubname" class="form-label">Vereinsname</label>
            <InputText id="clubname" class="form-control" @bind-Value="NewClubNomination!.NewClub.Name" />
        </div>

    </div>
    <button type="submit" class="btn btn-primary">Speichern</button>
</EditForm>

@code {
    private IList<ClubResponse> Clubs { get; set; } = [];
    private IList<RaceResponse> Races { get; set; } = [];

    [SupplyParameterFromForm(FormName = "NominateExistingClubForm")]
    private CreateCrewRequest? Nomination { get; set; }

    [SupplyParameterFromForm(FormName = "NominateNewClubForm")]
    private NominateNewClubRequest? NewClubNomination { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // No need to load data if we are processing form input.
        if (Nomination is null && NewClubNomination is null)
        {
            Races = await RaceService.GetRacesAsync();
            Clubs = await ClubService.GetClubsAsync();
        }

        Nomination ??= new();
        NewClubNomination ??= new();
    }

    private async Task NominateExistingClubAsync()
    {
        if (Nomination is null) { return; }

        await NominationService.NominateAsync(Nomination);
        Navigation.NavigateTo("/admin/crews");
    }

    private async Task NominateNewClubAsync()
    {
        if (NewClubNomination is null) { return; }

        await NominationService.NominateAsync(NewClubNomination);
        Navigation.NavigateTo("/admin/crews");
    }
}
