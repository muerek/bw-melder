@page "/admin/crews/nominate"
@rendermode InteractiveServer

@using BwMelder.Shared.Crews

@inject IClubService ClubService
@inject INominationService NominationService
@inject IRaceService RaceService
@inject NavigationManager Navigation

<h1>Mannschaft nominieren</h1>

<div class="py-3">
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="club-radio" id="existingclub-radio">
        <label class="form-check-label" for="existingclub-radio">Für bestehenden Verein</label>
    </div>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="club-radio" id="newclub-radio">
        <label class="form-check-label" for="newclub-radio">Für neuen Verein</label>
    </div>
</div>

<EditForm Model="Nomination" OnValidSubmit="NominateExistingClubAsync" FormName="NominateExistingClubForm" id="existingclub-form">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="row row-cols-md-2">

        <div class="mb-3">
            <label for="existingclub-raceid" class="form-label">Rennen</label>
            <InputSelect class="form-select" id="existingclub-raceid" required @bind-Value=Nomination!.RaceId>
                <option value=""></option>
                @foreach (var race in Races)
                {
                    <option value="@race.Id">@race.FullName()</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label for="existingclub-clubid" class="form-label">Verein</label>
            <InputSelect class="form-select" id="existingclub-clubid" required @bind-Value=Nomination!.ClubId>
                <option value=""></option>
                @foreach (var club in Clubs)
                {
                    <option value="@club.Id">@club.Name</option>
                }
            </InputSelect>
        </div>

    </div>
    <button type="submit" class="btn btn-primary">Speichern</button>
</EditForm>

<EditForm Model="NewClubNomination" OnValidSubmit="NominateNewClubAsync" FormName="NominateNewClubForm" id="newclub-form">
    <ObjectGraphDataAnnotationsValidator />
    <ValidationSummary />
    <div class="row row-cols-md-2">

        <div class="mb-3">
            <label for="newclub-raceid" class="form-label">Rennen</label>
            <InputSelect class="form-select" id="newclub-raceid" required @bind-Value=NewClubNomination!.RaceId>
                <option value=""></option>
                @foreach (var race in Races)
                {
                    <option value="@race.Id">@race.FullName()</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label for="newclub-clubname" class="form-label">Vereinsname</label>
            <InputText id="newclub-clubname" class="form-control" @bind-Value="NewClubNomination!.NewClub.Name" />
        </div>

    </div>
    <button type="submit" class="btn btn-primary">Speichern</button>
</EditForm>

@*<script src="/Components/Pages/Admin/Crews/NominateCrew.razor.js"></script>*@

@code {
    private IList<ClubResponse> Clubs { get; set; } = [];
    private IList<RaceResponse> Races { get; set; } = [];

    //[SupplyParameterFromForm(FormName = "NominateExistingClubForm")]
    private CreateCrewRequest Nomination { get; set; } = new();

    //[SupplyParameterFromForm(FormName = "NominateNewClubForm")]
    private NominateNewClubRequest NewClubNomination { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        // No need to load data if we are processing form input.
        //if (Nomination is null && NewClubNomination is null)
        {
            Races = await RaceService.GetRacesAsync();
            Clubs = await ClubService.GetClubsAsync();
        }

        //Nomination ??= new();
        //NewClubNomination ??= new();
    }

    private async Task NominateExistingClubAsync()
    {
        if (Nomination is null) { return; }

        await NominationService.NominateAsync(Nomination);
        Navigation.NavigateTo("/admin/crews");
    }

    private async Task NominateNewClubAsync()
    {
        if (NewClubNomination is null) { return; }

        await NominationService.NominateAsync(NewClubNomination);
        Navigation.NavigateTo("/admin/crews");
    }
}
