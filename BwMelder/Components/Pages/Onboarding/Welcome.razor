@page "/onboarding/welcome"

@using BwMelder.Authentication

<PageTitle>Willkommen</PageTitle>

<div class="text-center">
    <p class="display-1">
        <i class="bi bi-trophy"></i>
    </p>
    <p class="display-4 mb-1">
        @(userContext?.ClubName ?? "Dein Verein")
    </p>
    <p class="lead">
        fährt mit zum Bundeswettbewerb!
    </p>
</div>
<p>
    Zuerst müssen wir wissen, an wen wir uns bei euch wenden können.
    Bitte gib auf der nächsten Seite den Ansprechpartner an.
    Danach kannst du Sportler und Betreuer anmelden.
</p>
<a class="btn btn-primary" href="/onboarding/club-coach">Weiter</a>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    private UserContext? userContext;

    protected override async Task OnInitializedAsync()
    {
        userContext = await authenticationState.GetUserContextAsync();
    }
}
