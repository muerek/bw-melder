@page "/onboarding/club-coach"

@using BwMelder.Authentication

@inject IClubCoachService ClubCoachService;
@inject NavigationManager Navigation;

<PageTitle>Ansprechpartner eintragen</PageTitle>

<h1>Ansprechpartner eintragen</h1>

<p>
    Wen können für die weitere Organisation bis zum BW und die Kommunikation zu den Sportlern kontaktieren?
</p>

<ClubCoachForm ClubCoach="ClubCoach" OnValidSubmit="AddClubCoachAsync" />

@code {
    [SupplyParameterFromForm]
    public ClubCoachRequest? ClubCoach { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    private UserContext? userContext;

    protected override void OnInitialized()
    {
        // Parameter is already set if form data was posted.
        ClubCoach ??= new();
    }

    private async Task AddClubCoachAsync()
    {
        if (ClubCoach is null) { return; }

        // Always set the club ID to the current user's club.
        userContext = await authenticationState.GetUserContextAsync();
        ClubCoach.ClubId = userContext?.ClubId ?? throw new ApplicationException();

        await ClubCoachService.AddClubCoachAsync(ClubCoach!);
        Navigation.NavigateTo("/onboarding/done");
    }
}
