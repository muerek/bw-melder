@using BwMelder.Shared.Common

@* Contact is nested in different types. *@
@inherits Editor<ContactRequest>

<div class="mb-3">
    <label for="contact.phone" class="form-label">Telefonnr.</label>
    <InputText type="tel" id="contact.phone" class="form-control" @bind-Value="Value.Phone" />
</div>
<div class="mb-3">
    <label for="contact.email" class="form-label">E-Mail-Adresse</label>
    <InputText type="email" id="contact.email" class="form-control" @bind-Value="Value.EmailAddress" />
</div>
