<EditForm Model="ClubCoach" FormName="ClubCoachForm" OnValidSubmit="OnValidSubmit">
    <ObjectGraphDataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label for="firstname" class="form-label">Vorname</label>
        <InputText id="firstname" class="form-control" @bind-Value="ClubCoach!.FirstName" />
    </div>
    <div class="mb-3">
        <label for="firstname" class="form-label">Nachname</label>
        <InputText id="firstname" class="form-control" @bind-Value="ClubCoach!.LastName" />
    </div>
    <ContactSubform @bind-Value="ClubCoach.Contact" />
    <InputHiddenGuid id="clubid" @bind-Value="ClubCoach.ClubId" />
    <button type="submit" class="btn btn-primary">Speichern</button>
</EditForm>

@code {
    [Parameter]
    public ClubCoachRequest? ClubCoach { get; set; }

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    protected override void OnInitialized()
    {
        ClubCoach ??= new();
    }
}
